{
  "StartState": "Following",
  "Type": "Abstract",
  "Invulnerable": false,
  "Parameters": {
    "Appearance": {
      "Value": "Hex_Mannequin",
      "Description": "Model to be used."
    },
    "FlockArray": {
      "Value": [],
      "TypeHint": "String",
      "Description": "Array containing NPCs for this flock type."
    },
    "DropHexItem": {
      "Value": "Hex_Mannequin_Block",
      "Description": "Drop from Hex Creature"
    },
    "holdableItems": {
      "Value": [ "Furniture_Crude_Candle", "Tool_Hammer*", "Weapon_Assault_Rifle", "*Gun*", "*Handgun*" ],
      "Description": "Items that can be held in the hand"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "NameTranslationKey": {
      "Value": "Hex Creature",
      "Description": "Translation key for NPC name display"
    }
  },
  "IsMemory": false,
  "BreathesInWater": false,
  "DropList": { "Compute": "DropList" },
  "Appearance": {"Compute": "Appearance"},
  "DisableDamageFlock": false,
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Ignore",
  "FlockSpawnTypes": {"Compute": "FlockArray"},
  "FlockAllowedNPC": {"Compute": "FlockArray"},
  "ApplySeparation": true,
  "SeparationDistance": 1.0,
  "SeparationWeight": 0.6,
  "InventorySize": 0,
  "HotbarSize": 4,
  "OffHandSlots": 1,
  "DefaultOffHandSlot": 0,
  "PickupDropOnDeath": true,
  "MaxHealth": 200,
  "KnockbackScale": 2.0,
  "NameTranslationKey": {"Compute": "NameTranslationKey"},
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 12,
      "Gravity": 10,
      "RunThreshold": 0.3,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 10,
      "MaxClimbHeight": 3,
      "MaxDropHeight": 5
    }
  ],
  "StateTransitions": [
    {
      "$Comment": "Clear",
      "States": [
        {
          "From": [ ],
          "To": [ ]
        }
      ],
      "Actions": [
        {
          "Type": "ReleaseTarget"
        },
        {
          "Type": "ResetInstructions"
        },
        {
          "Type": "PlayAnimation",
          "Slot": "Status"
        }
      ]
    }
  ],
  "Instructions": [
    {
      "$Comment": "Adds the entity to the player flock",
      "Continue": true,
      "Instructions": [
        {
          "$Comment": "Add creature to flock",
          "Continue": true,
          "Sensor": {
            "Type": "Self",
            "Filters": [
              {
                "Type": "Flock",
                "FlockStatus": "NotMember"
              }
            ]
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Player",
                "Range": 15,
                "Filters": [
                  {
                    "Type": "Evoke:IsEvoker"
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "JoinFlock",
                  "ForceJoin": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Pick up item",
      "Continue": true,
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "Not",
            "Sensor": {
              "Type": "Self",
              "Filters": [
                {
                  "Type": "Evoke:IsInventoryFull",
                  "Inventories": ["Hotbar", "Storage"]
                }
              ]
            }
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "DroppedItem",
                "Range": 2,
                "Items": { "Compute": "holdableItems" }
              },
              "Actions": [
                {
                  "Type": "Evoke:HCPickUpItem",
                  "Items": { "Compute": "holdableItems" },
                  "Hoover": true
                }
              ],
              "BodyMotion": {
                "Type": "Seek",
                "StopDistance": 0.5
              }
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Change the state",
      "Continue": true,
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "FlockLeader"
          },
          "Instructions": [
            {
              "$Comment": "Store target position",
              "Sensor": {
                "Type": "Beacon",
                "Message": "EvokeTargetPosition",
                "Range": 100
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "SeekPosition"
                }
              ]
            },
            {
              "$Comment": "Follow the leader",
              "Sensor": {
                "Type": "Beacon",
                "Message": "EvokeFollowLeader",
                "Range": 100
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "Following"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Go to target position",
      "Sensor": {
        "Type": "State",
        "State": "SeekPosition"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "Evoke:ReadPosition",
            "Range": 30,
            "MinRange": 1
          },
          "BodyMotion": {
            "Type": "Seek",
            "SlowDownDistance": 3,
            "StopDistance": 0.1,
            "RelativeSpeed": 0.8
          }
        },
        {
          "Sensor": {
            "Type": "Evoke:ReadPosition",
            "Range": 2,
            "MinRange": 1
          },
          "Actions": [
            {
              "Type": "State",
              "State": "CheckTasks.Default"
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Idle state",
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      }
    },
    {
      "$Comment": "Entity movement",
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": "Following"
          },
          "Instructions": [
            {
              "$Comment": "Less than 1 block away from the leader",
              "Sensor": {
                "Type": "Player",
                "Range": 1,
                "LockOnTarget": true,
                "Filters": [
                  {
                    "Type": "Evoke:IsEvoker"
                  }
                ]
              },
              "HeadMotion": {
                "Type": "Aim",
                "Deflection": true,
                "Spread": 1
              },
              "BodyMotion": {
                "Type": "MaintainDistance",
                "DesiredDistanceRange": [1.5, 1.5],
                "MoveThreshold": 0.2,
                "RelativeForwardsSpeed": 0.6,
                "RelativeBackwardsSpeed": 0.3
              }
            },
            {
              "$Comment": "Less than 40 blocks away from the leader",
              "Sensor": {
                "Type": "Player",
                "Range": 40,
                "LockOnTarget": true,
                "Filters": [
                  {
                    "Type": "Evoke:IsEvoker"
                  }
                ]
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Target"
                  },
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": 5,
                    "StopDistance": 3,
                    "RelativeSpeed": 0.5
                  }
                }
              ]
            },
            {
              "$Comment": "Teleports to the leader if more than 40 blocks away",
              "Sensor": {
                "Type": "Target",
                "Filters": [
                  {
                    "Type": "Evoke:IsEvoker"
                  }
                ]
              },
              "BodyMotion": {
                "Type": "Teleport",
                "OffsetRange": [2, 3],
                "OffsetSector": 2,
                "Orientation": "TowardsTarget"
              },
              "Actions": [
                {
                  "Type": "SpawnParticles",
                  "Offset": [ 0, 0.5, 0 ],
                  "ParticleSystem": "Effect_Death",
                  "Once": true
                },
                {
                  "Type": "Timeout",
                  "Delay": [ 2, 2 ],
                  "DelayAfter": true
                }
              ]
            }
          ]
        },
        {
          "$Comment": "Check tasks to do",
          "Continue": true,
          "Sensor": {
            "Type": "State",
            "State": "CheckTasks"
          },
          "Instructions": [
            {
              "$Comment": "Verify item being held",
              "Sensor": {
                "Type": "State",
                "State": ".Default"
              },
              "Instructions": [
                {
                  "$Comment": "Checks if the inventory is full and if there is a chest nearby",
                  "Sensor": {
                    "Type": "Self",
                    "Filters": [
                      {
                        "Type": "Evoke:IsInventoryFull",
                        "Inventories": ["Hotbar", "Storage"]
                      },
                      {
                        "Type": "Evoke:HasChestNearby",
                        "HorizontalRange": 15,
                        "VerticalRange": 3
                      }
                    ]
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".StoreItems"
                    }
                  ]
                },
                {
                  "$Comment": "Checks if you are holding a sickle that is not broken and if has harvestable crop",
                  "Sensor": {
                    "Type": "Self",
                    "Filters": [
                      {
                        "Type": "Evoke:HasUsableItemInHand",
                        "Items": [ "Tool_Sickle*" ]
                      },
                      {
                        "Type": "Evoke:HasHarvestableCrop",
                        "HorizontalRange": 15,
                        "VerticalRange": 3
                      }
                    ]
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".Harvest"
                    }
                  ]
                },
                {
                  "$Comment": "Checks if you are holding a watering can with water and if has dry soil",
                  "Sensor": {
                    "Type": "Self",
                    "Filters": [
                      {
                        "Type": "Evoke:HasWateringCan",
                        "Filled": true
                      },
                      {
                        "Type": "Evoke:HasWettableSoil",
                        "HorizontalRange": 15,
                        "VerticalRange": 3
                      }
                    ]
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".Water"
                    }
                  ]
                },
                {
                  "$Comment": "Checks if you are holding an empty watering can, if has dry soil and water nearby to fill it",
                  "Sensor": {
                    "Type": "Self",
                    "Filters": [
                      {
                        "Type": "Evoke:HasWateringCan",
                        "Filled": false
                      },
                      {
                        "Type": "Evoke:HasWettableSoil",
                        "HorizontalRange": 15,
                        "VerticalRange": 3
                      },
                      {
                        "Type": "Evoke:HasWaterSourceNearby",
                        "HorizontalRange": 15,
                        "VerticalRange": 3
                      }
                    ]
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".Water"
                    }
                  ]
                },
                {
                  "$Comment": "Checks if you are holding a fertilizer and if has soil to fertilize",
                  "Sensor": {
                    "Type": "Self",
                    "Filters": [
                      {
                        "Type": "ItemInHand",
                        "Items": [ "Tool_Fertilizer" ]
                      },
                      {
                        "Type": "Evoke:HasFertilizableSoil",
                        "HorizontalRange": 15,
                        "VerticalRange": 3
                      }
                    ]
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".Fertilize"
                    }
                  ]
                },
                {
                  "$Comment": "Stores the items when there is no task to do",
                  "Sensor": {
                    "Type": "Self",
                    "Filters": [
                      {
                        "Type": "Evoke:HasItemsOnInventory",
                        "Inventories": ["Hotbar", "Storage"],
                        "SkipHotbarSlotZero": true
                      },
                      {
                        "Type": "Evoke:HasChestNearby",
                        "HorizontalRange": 15,
                        "VerticalRange": 3,
                        "CheckCanStore": true
                      }
                    ]
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".StoreItems"
                    }
                  ]
                },
                {
                  "$Comment": "Returns to standby mode",
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".Standby"
                    }
                  ]
                }
              ]
            },
            {
              "$Comment": "Search for a chest that has available slots",
              "Sensor": {
                "Type": "State",
                "State": ".StoreItems"
              },
              "Instructions": [
                {
                  "Reference": "Component_Evoke_Store_Items",
                  "Modify": {
                    "_ExportStates": ["SeekPosition"]
                  }
                }
              ]
            },
            {
              "$Comment": "Search for a plantation that is ready to harvest",
              "Sensor": {
                "Type": "State",
                "State": ".Harvest"
              },
              "Instructions": [
                {
                  "Reference": "Component_Evoke_Harvest",
                  "Modify": {
                    "_ExportStates": ["SeekPosition"]
                  }
                }
              ]
            },
            {
              "$Comment": "Search for a dry soil",
              "Sensor": {
                "Type": "State",
                "State": ".Water"
              },
              "Instructions": [
                {
                  "Reference": "Component_Evoke_Water",
                  "Modify": {
                    "_ExportStates": ["SeekPosition"]
                  }
                }
              ]
            },
            {
              "$Comment": "Search for soil to fertilize",
              "Sensor": {
                "Type": "State",
                "State": ".Fertilize"
              },
              "Instructions": [
                {
                  "Reference": "Component_Evoke_Fertilize",
                  "Modify": {
                    "_ExportStates": ["SeekPosition"]
                  }
                }
              ]
            },
            {
              "$Comment": "Standby state",
              "Sensor": {
                "Type": "State",
                "State": ".Standby"
              },
              "Actions": [
                {
                  "Type": "Timeout",
                  "Delay": [3, 3],
                  "Action": {
                    "Type": "State",
                    "State": "CheckTasks"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "$Comment": "Opens the Hex Creature profile when interacted with",
    "Instructions": [
      {
        "Continue": true,
        "Sensor": {
          "Type": "Any"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true
          }
        ]
      },
      {
        "$Comment": "Follow radial menu result",
        "Sensor": {
          "Type": "RadialMenuResult",
          "MenuId": "RadialMenu",
          "ResultId": "follow"
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Action",
            "Animation": "Jump",
            "Once": true
          },
          {
            "Type": "State",
            "State": "Following"
          }
        ]
      },
      {
        "$Comment": "Revival radial menu result",
        "Sensor": {
          "Type": "RadialMenuResult",
          "MenuId": "RadialMenu",
          "ResultId": "revival"
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Action",
            "Animation": "Revival"
          },
          {
            "Type": "State",
            "State": "Idle"
          }
        ]
      },
      {
        "$Comment": "Overdrive radial menu result",
        "Sensor": {
          "Type": "RadialMenuResult",
          "MenuId": "RadialMenu",
          "ResultId": "overdrive"
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Action",
            "Animation": "Overdrive"
          },
          {
            "Type": "State",
            "State": "Idle"
          }
        ]
      },
      {
        "$Comment": "Padoru spin radial menu result",
        "Sensor": {
          "Type": "RadialMenuResult",
          "MenuId": "RadialMenu",
          "ResultId": "padoru-spin"
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Action",
            "Animation": "Padoru_Spin"
          },
          {
            "Type": "State",
            "State": "Idle"
          }
        ]
      },
      {
        "$Comment": "Breakdance radial menu result",
        "Sensor": {
          "Type": "RadialMenuResult",
          "MenuId": "RadialMenu",
          "ResultId": "breakdance"
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Action",
            "Animation": "Breakdance"
          },
          {
            "Type": "State",
            "State": "Idle"
          }
        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "HasInteracted"
        },
        "Instructions": [
          {
            "Continue": true,
            "Actions": [
              {
                "Type": "PlaySound",
                "SoundEventId": "SFX_Plushie_Build"
              },
              {
                "Type": "OpenRadialMenu",
                "MenuId": "RadialMenu"
              }
            ]
          },
          {
            "Sensor": {
              "Type": "Player",
              "Range": 5,
              "Filters": [
                {
                  "Type": "ItemInHand",
                  "Items": [ "Evoke_Book*" ]
                }
              ]
            },
            "Instructions": [
              {
                "Actions": [
                  {
                    "Type": "Evoke:OpenHCProfile"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}