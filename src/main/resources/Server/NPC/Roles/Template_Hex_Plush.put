{
  "StartState": "Following",
  "Type": "Abstract",
  "Invulnerable": false,
  "Parameters": {
    "Appearance": {
      "Value": "Hex_Mannequin",
      "Description": "Model to be used."
    },
    "FlockArray": {
      "Value": [],
      "TypeHint": "String",
      "Description": "Array containing NPCs for this flock type."
    },
    "DropHexItem": {
      "Value": "Hex_Mannequin_Block",
      "Description": "Drop from Hex Creature"
    },
    "holdableItems": {
      "Value": [
        "Furniture_Crude_Candle",
        "Tool_Hammer*",
        "Weapon_Assault_Rifle",
        "*Gun*",
        "*Handgun*"
      ],
      "Description": "Items that can be held in the hand"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "NameTranslationKey": {
      "Value": "Hex Creature",
      "Description": "Translation key for NPC name display"
    }
  },
  "IsMemory": false,
  "BreathesInWater": false,
  "DropList": {
    "Compute": "DropList"
  },
  "Appearance": {
    "Compute": "Appearance"
  },
  "DisableDamageFlock": false,
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Ignore",
  "FlockSpawnTypes": {
    "Compute": "FlockArray"
  },
  "FlockAllowedNPC": {
    "Compute": "FlockArray"
  },
  "ApplySeparation": true,
  "SeparationDistance": 1.0,
  "SeparationWeight": 0.6,
  "SeparationLegacySteeringStrength": 0.2,
  "InventorySize": 0,
  "HotbarSize": 4,
  "OffHandSlots": 1,
  "DefaultOffHandSlot": 0,
  "PickupDropOnDeath": true,
  "MaxHealth": 200,
  "KnockbackScale": 2.0,
  "NameTranslationKey": {
    "Compute": "NameTranslationKey"
  },
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 12,
      "Gravity": 10,
      "RunThreshold": 0.3,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 10,
      "MaxClimbHeight": 3,
      "MaxDropHeight": 5
    }
  ],
  "StateTransitions": [
    {
      "$Comment": "Clear",
      "States": [
        {
          "From": [],
          "To": []
        }
      ],
      "Actions": [
        {
          "Type": "ReleaseTarget"
        },
        {
          "Type": "ResetInstructions"
        },
        {
          "Type": "PlayAnimation",
          "Slot": "Status"
        }
      ]
    }
  ],
  "Instructions": [
    {
      "$Comment": "Adds the entity to the player flock",
      "Reference": "Component_Evoke_Join_Evoker_Flock"
    },
    {
      "$Comment": "Pick up item",
      "Continue": true,
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "Not",
            "Sensor": {
              "Type": "Self",
              "Filters": [
                {
                  "Type": "Evoke:IsInventoryFull",
                  "Inventories": [
                    "Hotbar",
                    "Storage"
                  ]
                }
              ]
            }
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "DroppedItem",
                "Range": 2,
                "Items": {
                  "Compute": "holdableItems"
                }
              },
              "Actions": [
                {
                  "Type": "Evoke:HCPickUpItem",
                  "Items": {
                    "Compute": "holdableItems"
                  },
                  "Hoover": true
                }
              ],
              "BodyMotion": {
                "Type": "Seek",
                "StopDistance": 0.5
              }
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Beacon wand command",
      "Reference": "Component_Evoke_Wand_Commands",
      "Modify": {
        "_ExportStates": [
          "SeekPosition",
          "Following"
        ],
        "Range": 100
      }
    },
    {
      "$Comment": "Go to target position",
      "Sensor": {
        "Type": "State",
        "State": "SeekPosition"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "Evoke:ReadPosition",
            "Range": 30,
            "MinRange": 1
          },
          "BodyMotion": {
            "Type": "Seek",
            "SlowDownDistance": 3,
            "StopDistance": 0.1,
            "RelativeSpeed": 0.8
          }
        },
        {
          "Sensor": {
            "Type": "Evoke:ReadPosition",
            "Range": 2,
            "MinRange": 1
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Idle"
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Idle state",
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      }
    },
    {
      "$Comment": "Head motion",
      "Continue": true,
      "Sensor": {
        "Type": "Player",
        "Range": 2,
        "Filters": [
          {
            "Type": "ViewSector",
            "ViewSector": 120
          }
        ]
      },
      "HeadMotion": {
        "Type": "Watch",
        "RelativeTurnSpeed": 0.5
      }
    },
    {
      "$Comment": "Entity movement",
      "Sensor": {
        "Type": "State",
        "State": "Following"
      },
      "Instructions": [
        {
          "$Comment": "Less than 1 block away from the leader",
          "Sensor": {
            "Type": "Player",
            "Range": 1,
            "LockOnTarget": true,
            "Filters": [
              {
                "Type": "Evoke:IsEvoker"
              }
            ]
          },
          "HeadMotion": {
            "Type": "Aim",
            "Deflection": true,
            "Spread": 1
          },
          "BodyMotion": {
            "Type": "MaintainDistance",
            "DesiredDistanceRange": [
              1.5,
              1.5
            ],
            "MoveThreshold": 0.2,
            "RelativeForwardsSpeed": 0.6,
            "RelativeBackwardsSpeed": 0.3
          }
        },
        {
          "Reference": "Component_Evoke_Follow_Evoker_Walking"
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "$Comment": "Opens the Hex Creature profile when interacted with",
    "Instructions": [
      {
        "Continue": true,
        "Sensor": {
          "Type": "Any"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true
          }
        ]
      },
      {
        "$Comment": "Follow radial menu result",
        "Sensor": {
          "Type": "RadialMenuResult",
          "MenuId": "RadialMenu",
          "ResultId": "follow"
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Action",
            "Animation": "Jump",
            "Once": true
          },
          {
            "Type": "State",
            "State": "Following"
          }
        ]
      },
      {
        "$Comment": "Revival radial menu result",
        "Sensor": {
          "Type": "RadialMenuResult",
          "MenuId": "RadialMenu",
          "ResultId": "revival"
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Action",
            "Animation": "Revival"
          },
          {
            "Type": "State",
            "State": "Idle"
          }
        ]
      },
      {
        "$Comment": "Overdrive radial menu result",
        "Sensor": {
          "Type": "RadialMenuResult",
          "MenuId": "RadialMenu",
          "ResultId": "overdrive"
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Action",
            "Animation": "Overdrive"
          },
          {
            "Type": "State",
            "State": "Idle"
          }
        ]
      },
      {
        "$Comment": "Padoru spin radial menu result",
        "Sensor": {
          "Type": "RadialMenuResult",
          "MenuId": "RadialMenu",
          "ResultId": "padoru-spin"
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Action",
            "Animation": "Padoru_Spin"
          },
          {
            "Type": "State",
            "State": "Idle"
          }
        ]
      },
      {
        "$Comment": "Breakdance radial menu result",
        "Sensor": {
          "Type": "RadialMenuResult",
          "MenuId": "RadialMenu",
          "ResultId": "breakdance"
        },
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Action",
            "Animation": "Breakdance"
          },
          {
            "Type": "State",
            "State": "Idle"
          }
        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "HasInteracted"
        },
        "Instructions": [
          {
            "Continue": true,
            "Actions": [
              {
                "Type": "PlaySound",
                "SoundEventId": "SFX_Plushie_Build"
              },
              {
                "Type": "OpenRadialMenu",
                "MenuId": "RadialMenu"
              }
            ]
          },
          {
            "Sensor": {
              "Type": "Player",
              "Range": 5,
              "Filters": [
                {
                  "Type": "ItemInHand",
                  "Items": [
                    "Evoke_Book*"
                  ]
                }
              ]
            },
            "Instructions": [
              {
                "Actions": [
                  {
                    "Type": "Evoke:OpenHCProfile"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}